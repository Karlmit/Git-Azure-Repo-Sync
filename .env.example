# Copy this file to .env and fill in real values. Never commit the real .env file.

# Login credentials for the gitsync web GUI.
APP_USERNAME=PLACEHOLDER_USERNAME
APP_PASSWORD=PLACEHOLDER_STRONG_PASSWORD

# 32-byte key (base64) used to encrypt GitHub/Azure DevOps PATs at rest.
# Generate one with: openssl rand -base64 32
ENCRYPTION_KEY=PLACEHOLDER_BASE64_32_BYTE_KEY

# Optional tuning (defaults shown).
LOG_LEVEL=info
DEFAULT_POLL_INTERVAL_MINUTES=2
LOG_RETENTION_DAYS=30
LOG_MAX_ROWS_PER_CONNECTION=2000

# Optional. If set, gitsync sends an HTTP POST here the moment a ref newly needs
# your approval (see "How syncing works" in the README) - not on every poll while
# it's still unresolved, just once when it first appears. The body is JSON:
# {"message": "<html>"}, where message is an HTML-formatted summary naming the
# connection and ref, meant to be piped into something like a Power Automate flow,
# Slack/Teams webhook, or similar. Leave unset to disable notifications entirely.
# NOTIFY_WEBHOOK_URL=https://your-automation-endpoint.example.com/trigger

# Optional. Where this instance is reachable from on your LAN, e.g. your Unraid
# box's eth0 IP and the port from docker-compose.yml. When set, notifications
# include a link straight to the connection that needs attention. Update this if
# your LAN IP ever changes.
# APP_BASE_URL=http://192.168.1.66:3012

# Which user the app runs as inside the container (default shown). The container
# starts as root, chowns the /data mount to this PUID:PGID, then drops to it before
# running anything - so a plain bind mount to /data just works regardless of what
# it was owned by beforehand. On Unraid, set these to 99/100 to match the
# nobody:users ownership your other shares already use, if you'd prefer that.
PUID=1000
PGID=1000
